{{ 'section-classes-showcase.css' | asset_url | stylesheet_tag }}

<section class="classes-showcase color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width classes-showcase__inner">
    <div class="classes-showcase__header">
      {%- if section.settings.eyebrow != blank -%}<p class="classes-showcase__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="classes-showcase__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="classes-showcase__intro rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="classes-showcase__grid">
        {%- for block in section.blocks -%}
          <article class="class-card" {{ block.shopify_attributes }}>
            <div class="class-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 550, 750, 900', sizes: '(min-width: 990px) 33vw, 100vw', class: 'class-card__image', alt: block.settings.image.alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'class-card__placeholder placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="class-card__content">
              {%- if block.settings.date != blank -%}<p class="class-card__date">{{ block.settings.date | escape }}</p>{%- endif -%}
              <h3 class="class-card__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.description != blank -%}<div class="class-card__description rte">{{ block.settings.description }}</div>{%- endif -%}
              <div class="class-card__footer">
                {%- if block.settings.price != blank -%}<strong class="class-card__price">{{ block.settings.price | escape }}</strong>{%- endif -%}
                {%- if block.settings.link != blank -%}<a class="link animate-arrow" href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'Book now' | escape }} <span class="icon-wrap">&rarr;</span></a>{%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="classes-showcase__button"><a class="button" href="{{ section.settings.button_link | default: '/pages/classes' }}">{{ section.settings.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Classes showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Learn with us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Classes & workshops" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h1", "options": [{ "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" }] },
    { "type": "richtext", "id": "text", "label": "Introduction", "default": "<p>Learn new skills, enjoy time with other yarn lovers and leave with something you are proud of.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View classes & book" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "class",
      "name": "Class",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "date", "label": "Date and time", "default": "Date to be announced" },
        { "type": "text", "id": "title", "label": "Class name", "default": "New class coming soon" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Add the class description, skill level and what is included.</p>" },
        { "type": "text", "id": "price", "label": "Price", "default": "Price coming soon" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Book now" },
        { "type": "url", "id": "link", "label": "Booking link" }
      ]
    }
  ],
  "presets": [{ "name": "Classes showcase" }]
}
{% endschema %}
