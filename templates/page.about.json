    "friendly_help": {
      "type": "image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Friendly help for your next project",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>We believe that choosing yarn should be part of the pleasure of making something.</p><p>Whether you know exactly what you need or would appreciate some friendly guidance, we are always happy to help you explore colours, textures and suitable supplies for your next project.</p>",
            "text_style": "body"
          }
        }
      },
