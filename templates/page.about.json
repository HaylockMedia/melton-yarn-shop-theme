        "heading": {
          "type": "heading",
          "settings": {
            "heading": "A place to meet, learn and be inspired",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Our shop is also a welcoming place for people to meet, learn and be inspired.</p><p>Through our classes, workshops and events, we hope to bring local makers together and encourage everyone—from complete beginners to experienced crafters—to enjoy working with yarn.</p>",
            "text_style": "body"
          }
        },
