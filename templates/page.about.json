    "our_range": {
      "type": "image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Beautiful yarns, thoughtfully chosen",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>From our shop at Bowley Court, we offer a carefully chosen range of beautiful yarns, patterns, needles, hooks and useful accessories.</p><p>We stock trusted brands including Stylecraft, King Cole, James C. Brett, Katia and many more, with choices to suit different projects, tastes and budgets.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": ["heading", "text"],
      "settings": {
        "height": "adapt",
        "desktop_image_width": "medium",
