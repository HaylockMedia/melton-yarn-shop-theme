        "heading": {
          "type": "heading",
          "settings": {
            "heading": "A new chapter",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Previously known as Bath and Yarn Emporium, our shop is beginning an exciting new chapter with a new name and a fresh look.</p><p>Although our name is changing, the warm welcome, personal service and passion behind the business remain the same.</p>",
            "text_style": "body"
          }
        }
      },
